# Navo environment variables (copy to .env.local)

# ─── Required for auth (Sign in with Apple / Google / email / wallet) ───
# Create app at https://dashboard.privy.io — enable Apple, Google, Email
# Add your production domain under Allowed origins
VITE_PRIVY_APP_ID=

# ─── Polymarket public APIs (defaults work; override if needed) ───
VITE_POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
VITE_POLYMARKET_CLOB_API=https://clob.polymarket.com
VITE_POLYMARKET_DATA_API=https://data-api.polymarket.com
VITE_POLYGON_RPC_URL=https://polygon-rpc.com

# ─── Sign server (required for trading in production) ───
# Local dev: leave as relative paths (Vite proxies to server/sign.mjs)
VITE_POLYMARKET_SIGN_URL=/api/polymarket/sign
VITE_POLYMARKET_BUILDER_HEALTH_URL=/api/polymarket/health
# Production example:
# VITE_POLYMARKET_SIGN_URL=https://navo-sign.up.railway.app/sign
# VITE_POLYMARKET_BUILDER_HEALTH_URL=https://navo-sign.up.railway.app/health

# Builder code for order attribution (bytes32 hex from polymarket.com/settings?tab=builder)
VITE_POLYMARKET_BUILDER_CODE=

# Get from https://polymarket.com/settings?tab=builder
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
SIGN_PORT=8787
HOST=0.0.0.0
# Production CORS — comma-separated frontend origins (never use * in production)
ALLOWED_ORIGINS=http://localhost:5173,https://navomarkets.vercel.app
# Require wallet signature before builder HMAC signing (set false only for local debugging)
SIGN_REQUIRE_WALLET_AUTH=true
SIGN_AUTH_MAX_AGE_SEC=300
