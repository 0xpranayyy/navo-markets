FROM node:20-alpine
WORKDIR /app
COPY server/sign.mjs ./server/sign.mjs
ENV NODE_ENV=production
ENV SIGN_PORT=8787
ENV HOST=0.0.0.0
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8787/health || exit 1
CMD ["node", "server/sign.mjs"]
